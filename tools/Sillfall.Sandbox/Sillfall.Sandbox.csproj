<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SillfallWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(SillfallWindowsMinVersion)</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Sillfall.Sandbox</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sillfall.Core\Sillfall.Core.csproj" />
    <ProjectReference Include="..\..\src\Sillfall.Platform\Sillfall.Platform.csproj" />
    <ProjectReference Include="..\..\src\Sillfall.Render\Sillfall.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

</Project>
