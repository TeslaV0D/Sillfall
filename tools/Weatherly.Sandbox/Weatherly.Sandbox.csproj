<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(WeatherlyWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WeatherlyWindowsMinVersion)</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Weatherly.Sandbox</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Weatherly.Core\Weatherly.Core.csproj" />
    <ProjectReference Include="..\..\src\Weatherly.Platform\Weatherly.Platform.csproj" />
    <ProjectReference Include="..\..\src\Weatherly.Render\Weatherly.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

</Project>
