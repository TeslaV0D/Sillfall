<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the release setups (ADR-0018). Paste it into the SignPath project
  (Artifact configurations). The release job uploads both setups as one ZIP and passes the version.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Sillfall-Setup-*.exe" max-matches="unbounded" product-name="Sillfall" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
