<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WeatherlyWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(WeatherlyWindowsMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(WeatherlyWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Weatherly.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!--
    The platform decides the runtime identifier. Without an explicit platform (plain "dotnet build")
    the app builds for the architecture of the build machine.
  -->
  <PropertyGroup>
    <Platforms>x64;ARM64</Platforms>
    <HostPlatform>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().Replace('X64', 'x64').Replace('Arm64', 'ARM64'))</HostPlatform>
    <Platform Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'ARM64'">$(HostPlatform)</Platform>
    <RuntimeIdentifier>win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Default is the packaged (MSIX) app. For a quick run without deployment, build unpackaged by
    setting the property WindowsPackageType=None (see README.md for the command line).
    Unpackaged builds carry the Windows App SDK runtime with them, so nothing has to be installed.
  -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'None'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Weatherly.Core\Weatherly.Core.csproj" />
    <ProjectReference Include="..\Weatherly.Platform\Weatherly.Platform.csproj" />
    <ProjectReference Include="..\Weatherly.Render\Weatherly.Render.csproj" />
    <ProjectReference Include="..\Weatherly.Audio\Weatherly.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Lets Visual Studio offer MSIX packaging before the Windows App SDK package is restored. -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Identity stamped into a copy of Package.appxmanifest when an MSIX is built (ADR-0017).
    The defaults match the manifest. A release overrides them with the name reserved in Partner Center;
    the certificate subject has to be the same publisher string.
  -->
  <PropertyGroup>
    <WeatherlyPackageName Condition="'$(WeatherlyPackageName)' == ''">Weatherly.Dev</WeatherlyPackageName>
    <WeatherlyPackagePublisher Condition="'$(WeatherlyPackagePublisher)' == ''">CN=Weatherly Development</WeatherlyPackagePublisher>
    <WeatherlyPackagePublisherDisplayName Condition="'$(WeatherlyPackagePublisherDisplayName)' == ''">Weatherly Development</WeatherlyPackagePublisherDisplayName>
    <WeatherlyPackageDisplayName Condition="'$(WeatherlyPackageDisplayName)' == ''">$(Product)</WeatherlyPackageDisplayName>
    <WeatherlyPackageDescription Condition="'$(WeatherlyPackageDescription)' == ''">Animated weather on top of your open windows.</WeatherlyPackageDescription>
    <!-- Directory.Build.props keeps three version numbers. MSIX wants four; the package script checks the same rule. -->
    <WeatherlyPackageVersion Condition="'$(WeatherlyPackageVersion)' == ''">$(Version).0</WeatherlyPackageVersion>
  </PropertyGroup>

  <!--
    Runs only for a real package build. Replacing the AppxManifest item here is early enough:
    _GenerateCurrentProjectAppxManifest reads @(AppxManifest) afterwards (Windows App SDK MSIX targets).
    Do not add an AppxManifest item at evaluation time. The smoke test builds with WindowsPackageType=None,
    and the SDK rejects that combination.
  -->
  <Target Name="StampPackageManifest" BeforeTargets="BeforeGenerateAppxManifest" Condition="'$(GenerateAppxPackageOnBuild)' == 'true'">
    <PropertyGroup>
      <_StampedManifest>$(IntermediateOutputPath)Package.stamped.appxmanifest</_StampedManifest>
      <_ManifestNamespaces>&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='uap' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10' /&gt;&lt;Namespace Prefix='uap5' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10/5' /&gt;</_ManifestNamespaces>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="@(AppxManifest)" DestinationFiles="$(_StampedManifest)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Identity/@Name" Value="$(WeatherlyPackageName)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Identity/@Publisher" Value="$(WeatherlyPackagePublisher)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Identity/@Version" Value="$(WeatherlyPackageVersion)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Properties/m:DisplayName" Value="$(WeatherlyPackageDisplayName)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Properties/m:PublisherDisplayName" Value="$(WeatherlyPackagePublisherDisplayName)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Applications/m:Application/uap:VisualElements/@DisplayName" Value="$(WeatherlyPackageDisplayName)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Applications/m:Application/uap:VisualElements/@Description" Value="$(WeatherlyPackageDescription)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Applications/m:Application/m:Extensions/uap:Extension/uap:Protocol/uap:DisplayName" Value="$(WeatherlyPackageDisplayName) scene" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Applications/m:Application/m:Extensions/uap5:Extension/uap5:StartupTask/@DisplayName" Value="$(WeatherlyPackageDisplayName)" Namespaces="$(_ManifestNamespaces)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_StampedManifest)" />
    </ItemGroup>
  </Target>

</Project>
