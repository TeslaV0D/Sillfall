<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Weatherly.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:diagnostics="using:Weatherly.Core.Diagnostics">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,16,32,32" Spacing="16">
                <TextBlock x:Name="HeadingText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Milestones M1 to M5. Every monitor gets a transparent, click-through overlay. It can show a calibration pattern (magenta frame on the monitor edges, colored corner markers, a grid with 100-pixel cells at 100 % scaling, a white alpha ramp, a half-transparent black block) and the surfaces the weather will interact with: window top edges in green, window sides in orange, the floor above the taskbar in blue. Calibration drops test the render loop: they fall, rest on window edges, move with their window and fall off when it is shaken or closed. Rain is the first weather effect: drops at different depths, splashes, puddles on window edges, drips down the sides and, in heavy rain, waterfalls from the corners. Snow piles up on window edges and the taskbar, falls off in clumps when a window is shaken, jerked or closed, and melts when it stops snowing."
                    TextWrapping="Wrap" />

                <StackPanel Spacing="4">
                    <ToggleSwitch
                        x:Name="OverlaySwitch"
                        Header="Overlay"
                        Toggled="OnOptionToggled" />
                    <ToggleSwitch
                        x:Name="PatternSwitch"
                        Header="Show the calibration pattern"
                        Toggled="OnOptionToggled" />
                    <ToggleSwitch
                        x:Name="DropsSwitch"
                        Header="Calibration drops (render loop test)"
                        Toggled="OnOptionToggled" />
                    <Slider
                        x:Name="RainSlider"
                        Width="320"
                        HorizontalAlignment="Left"
                        Header="Rain intensity"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="5"
                        ValueChanged="OnSliderChanged" />
                    <Slider
                        x:Name="RainDepthSlider"
                        Width="320"
                        HorizontalAlignment="Left"
                        Header="Rain depth: share of drops that hit windows"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="5"
                        Value="50"
                        ValueChanged="OnSliderChanged" />
                    <Slider
                        x:Name="SnowSlider"
                        Width="320"
                        HorizontalAlignment="Left"
                        Header="Snow intensity"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="5"
                        ValueChanged="OnSliderChanged" />
                    <ToggleSwitch
                        x:Name="SoundSwitch"
                        Header="Rain sound"
                        Toggled="OnSoundToggled" />
                    <TextBlock
                        x:Name="SoundStatus"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="SurfacesSwitch"
                        Header="Show detected surfaces (debug layer)"
                        Toggled="OnOptionToggled" />
                    <ToggleSwitch
                        x:Name="CaptureSwitch"
                        Header="Hide the overlay from screenshots and screen recordings"
                        Toggled="OnOptionToggled" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Monitors" />
                    <ItemsControl x:Name="MonitorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Padding="0,2"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Checks" />
                    <ItemsControl x:Name="DiagnosticsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="diagnostics:DiagnosticResult">
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- The state is always spelled out, it never relies on color alone. -->
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind StatusText}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Detail}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Click="OnCheckAgainClicked" Content="Check again" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
