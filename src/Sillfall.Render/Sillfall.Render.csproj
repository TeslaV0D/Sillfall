<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SillfallWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(SillfallWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Sillfall.Render</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sillfall.Core\Sillfall.Core.csproj" />
    <InternalsVisibleTo Include="Sillfall.Render.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DirectComposition" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

  <!-- The visitors and their props (PLAN.md, section 6), own drawings listed in ASSETS.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Visitors\*.svg" LogicalName="Sillfall.Render.Visitors.%(Filename).svg" />
  </ItemGroup>

  <Import Project="Shaders\Shaders.targets" />

</Project>
