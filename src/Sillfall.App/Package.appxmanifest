<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">

  <!-- Development identity. Name and Publisher are replaced with the Store reservation in M14. -->
  <Identity
    Name="Sillfall.Dev"
    Publisher="CN=Sillfall Development"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="eea4a309-960d-4b58-ae92-8b844afa60a4" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Sillfall</DisplayName>
    <PublisherDisplayName>Sillfall</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on" />
    </uap10:PackageIntegrity>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Sillfall"
        Description="Animated weather that settles on the edges of your open windows."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Scene links: sillfall://scene?d=... -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="sillfall">
            <uap:DisplayName>Sillfall scene</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- Autostart, off until the user switches it on in the settings. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="SillfallStartup" Enabled="false" DisplayName="Sillfall" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Only for the weather sync with "this PC's location"; Windows asks before the first use. -->
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
