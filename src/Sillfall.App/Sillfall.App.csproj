<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(SillfallWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(SillfallWindowsMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(SillfallWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Sillfall.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!--
    The platform decides the runtime identifier. Without an explicit platform (plain "dotnet build")
    the app builds for the architecture of the build machine.
  -->
  <PropertyGroup>
    <Platforms>x64;ARM64</Platforms>
    <HostPlatform>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().Replace('X64', 'x64').Replace('Arm64', 'ARM64'))</HostPlatform>
    <Platform Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'ARM64'">$(HostPlatform)</Platform>
    <RuntimeIdentifier>win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Default is the packaged (MSIX) app. For a quick run without deployment, build unpackaged by
    setting the property WindowsPackageType=None (see README.md for the command line).
    Unpackaged builds carry the Windows App SDK runtime with them, so nothing has to be installed.
  -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'None'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sillfall.Core\Sillfall.Core.csproj" />
    <ProjectReference Include="..\Sillfall.Platform\Sillfall.Platform.csproj" />
    <ProjectReference Include="..\Sillfall.Render\Sillfall.Render.csproj" />
    <ProjectReference Include="..\Sillfall.Audio\Sillfall.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Lets Visual Studio offer MSIX packaging before the Windows App SDK package is restored. -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Identity stamped into a copy of Package.appxmanifest when an MSIX is built (ADR-0017).
    The defaults match the manifest. A release overrides them with the name reserved in Partner Center;
    the certificate subject has to be the same publisher string.
  -->
  <PropertyGroup>
    <SillfallPackageName Condition="'$(SillfallPackageName)' == ''">Sillfall.Dev</SillfallPackageName>
    <SillfallPackagePublisher Condition="'$(SillfallPackagePublisher)' == ''">CN=Sillfall Development</SillfallPackagePublisher>
    <SillfallPackagePublisherDisplayName Condition="'$(SillfallPackagePublisherDisplayName)' == ''">Sillfall</SillfallPackagePublisherDisplayName>
    <SillfallPackageDisplayName Condition="'$(SillfallPackageDisplayName)' == ''">$(Product)</SillfallPackageDisplayName>
    <SillfallPackageDescription Condition="'$(SillfallPackageDescription)' == ''">Animated weather that settles on the edges of your open windows.</SillfallPackageDescription>
    <!-- Directory.Build.props keeps three version numbers. MSIX wants four; the package script checks the same rule. -->
    <SillfallPackageVersion Condition="'$(SillfallPackageVersion)' == ''">$(Version).0</SillfallPackageVersion>
  </PropertyGroup>

  <!--
    Runs only for a real package build. Replacing the AppxManifest item here is early enough:
    _GenerateCurrentProjectAppxManifest reads @(AppxManifest) afterwards (Windows App SDK MSIX targets).
    Do not add an AppxManifest item at evaluation time. The smoke test builds with WindowsPackageType=None,
    and the SDK rejects that combination.
  -->
  <Target Name="StampPackageManifest" BeforeTargets="BeforeGenerateAppxManifest" Condition="'$(GenerateAppxPackageOnBuild)' == 'true'">
    <PropertyGroup>
      <_StampedManifest>$(IntermediateOutputPath)Package.stamped.appxmanifest</_StampedManifest>
      <_ManifestNamespaces>&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='uap' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10' /&gt;&lt;Namespace Prefix='uap5' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10/5' /&gt;</_ManifestNamespaces>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="@(AppxManifest)" DestinationFiles="$(_StampedManifest)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Identity/@Name" Value="$(SillfallPackageName)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Identity/@Publisher" Value="$(SillfallPackagePublisher)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Identity/@Version" Value="$(SillfallPackageVersion)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Properties/m:DisplayName" Value="$(SillfallPackageDisplayName)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Properties/m:PublisherDisplayName" Value="$(SillfallPackagePublisherDisplayName)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Applications/m:Application/uap:VisualElements/@DisplayName" Value="$(SillfallPackageDisplayName)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Applications/m:Application/uap:VisualElements/@Description" Value="$(SillfallPackageDescription)" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Applications/m:Application/m:Extensions/uap:Extension/uap:Protocol/uap:DisplayName" Value="$(SillfallPackageDisplayName) scene" Namespaces="$(_ManifestNamespaces)" />
    <XmlPoke XmlInputPath="$(_StampedManifest)" Query="/m:Package/m:Applications/m:Application/m:Extensions/uap5:Extension/uap5:StartupTask/@DisplayName" Value="$(SillfallPackageDisplayName)" Namespaces="$(_ManifestNamespaces)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_StampedManifest)" />
    </ItemGroup>
  </Target>

</Project>
